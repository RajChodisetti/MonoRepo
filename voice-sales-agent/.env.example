ENVIRONMENT=development
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+61XXXXXXXXX
DEEPGRAM_API_KEY=your_deepgram_key
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini
CARTESIA_API_KEY=your_cartesia_key
# Indian receptionist (Cartesia): ff1bb1a9… = Customer Support Lady, 3b554273… = Indian Lady
CARTESIA_VOICE_ID=ff1bb1a9-c582-4570-9670-5f46169d0fc8
CARTESIA_LANGUAGE=en_in

# MonoRepo backend (restaurant reservations + site context)
MONOREPO_API_URL=http://localhost:8080
API_TIMEOUT_MS=2000
# API_AUTH_TOKEN=

# Tuvi corporate website assistant (browser ?agent=corporate)
CALENDLY_URL=https://calendly.com/your-link

# Tuvi website consultation API (Go backend)
TUVI_WEBSITE_API_URL=http://localhost:8090
TUVI_API_TOKEN=local-dev-tuvi-api-token-change-me
API_TIMEOUT_MS=20000
TUVI_API_TIMEOUT_MS=20000
