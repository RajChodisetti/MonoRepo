APP_NAME=restaurant-platform
APP_ENV=local
APP_VERSION=dev

HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

LOG_LEVEL=debug
LOG_FORMAT=text

DATABASE_URL=postgres://postgres:postgres@localhost:5432/restaurant_platform?sslmode=disable
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_CONNECT_TIMEOUT=5s

REDIS_URL=

EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_API_BASE_URL=https://api.resend.com
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tuvi Solutions
EMAIL_DISABLE_SENDING=true
# Development/staging safety redirect only; production validation requires empty.
EMAIL_REDIRECT_TO=
EMAIL_OPEN_TRACKING_ENABLED=true

# Required only when EMAIL_PROVIDER=zoho for the generic/non-bulk adapter.
# Quota-managed outreach rotation can use Google Workspace or Zoho below.
ZOHO_ACCOUNT_ID=
ZOHO_FROM_EMAIL=
ZOHO_REGION=com
ZOHO_API_BASE_URL=https://mail.zoho.com/api/accounts
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Bulk outreach sends only admin-approved campaigns for approved, OCR-verified profiles.
OUTREACH_BULK_MAX=150
OUTREACH_EMAILS_PER_ACCOUNT=40
# Forty durable slots over eight hours (~12 minutes per slot), with a persisted
# random 2-5 minute offset and a cross-account minimum-delay guard.
OUTREACH_SEND_WINDOW=8h
OUTREACH_SEND_JITTER_MIN=2m
OUTREACH_SEND_JITTER_MAX=5m
# A fully used account becomes available again only after this durable cooldown.
OUTREACH_EMAIL_COOLDOWN=24h
# JSON arrays of quota-managed HTTPS accounts. `key` is a stable, non-secret
# identity. Google Workspace uses one offline OAuth refresh token per mailbox.
OUTREACH_ZOHO_ACCOUNTS_JSON=[]
OUTREACH_GOOGLE_WORKSPACE_ACCOUNTS_JSON=[]

PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_MARKETING_URL=http://localhost:3001
PRESENTATION_SITE_URL=http://localhost:3001/services/restaurants

# Tuvi company consultation scheduler (served by the main API)
TUVI_API_TOKEN=local-dev-tuvi-api-token-change-me
CONSULTATION_NOTIFY_EMAIL=contact@tuvisolutions.com
CONSULTATION_TIMEZONE=Australia/Sydney
CONSULTATION_BUSINESS_HOUR_START=9
CONSULTATION_BUSINESS_HOUR_END=17
CONSULTATION_SLOT_DURATION_MINUTES=30
CONSULTATION_DEFAULT_AVAILABILITY_DAYS=5
CONSULTATION_AVAILABILITY_HORIZON_DAYS=14
# PostgreSQL is the sole consultation availability and booking record for now.
# Keep Google Calendar disabled until a future approved integration rollout.
CONSULTATION_GOOGLE_CALENDAR_DISABLED=true
CONSULTATION_GOOGLE_CALENDAR_ID=
CONSULTATION_GOOGLE_SERVICE_ACCOUNT_JSON=

# The Go API does not need an LLM for the Python OCR workflow. Enable a
# provider explicitly only when LLM_API_KEY and LLM_MODEL are configured.
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Hugging Face — used by automation/outreach scraping scripts
HUGGING_FACE_API_KEY=
HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct
MENU_OCR_MODEL=Qwen/Qwen2-VL-7B-Instruct

# Places discovers businesses first; Apollo fills missing owner/work-email fields.
GOOGLE_PLACES_API_KEY=
PLACES_API_BASE_URL=https://places.googleapis.com/v1
PLACES_PHOTO_LIMIT=10
PLACES_PHOTO_MAX_WIDTH=1600
PLACES_API_TIMEOUT=20s
APOLLO_API_KEY=
APOLLO_API_BASE_URL=https://api.apollo.io/api/v1
APOLLO_ENRICHMENT_ENABLED=true
LEAD_INGESTION_ENABLED=false
LEAD_INGESTION_MAX_REQUESTS=500
INGESTION_TYPE=restaurant
INGESTION_CITIES=Sydney,Melbourne,Perth,Adelaide,Brisbane
SCRAPE_WORKER_POLL_SECONDS=15
SCRAPE_JOB_LEASE_SECONDS=900
SCRAPE_INITIAL_GRID_ROWS=4
SCRAPE_INITIAL_GRID_COLUMNS=4
SCRAPE_CELL_PAGE_LIMIT=3
SCRAPE_GRID_MAX_DEPTH=12

# Lead OCR verification cron (automation/outreach/verify_leads_from_db.py)
LEAD_OCR_VERIFICATION_ENABLED=false
LEAD_OCR_BATCH_SIZE=50
LEAD_OCR_MAX_ATTEMPTS=3
LEAD_OCR_RETRY_AFTER_HOURS=24

VOICE_PROVIDER=disabled
VOICE_WEBHOOK_SECRET=

STORAGE_PROVIDER=disabled
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

TOKEN_SECRET=local-dev-token-secret-change-me-32chars
JWT_ACCESS_TOKEN_TTL=24h

DEMO_TOKEN_TTL=720h

ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=password123
ADMIN_FULL_NAME=Local Admin

JOB_BUFFER_SIZE=32
JOB_RETRY_DELAY=2s

# Demo site template: 1 = Cinematic (warm dining), 2 = Aurora (futuristic tech)
# Mirror this value in template/.env.local for Next.js
TEMPLATE=1
