# HTTP
HTTP_ADDR=:8090
TUVI_API_TOKEN=local-dev-tuvi-api-token-change-me

# Postgres (create DB first: createdb tuvi_website)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tuvi_website?sslmode=disable

# Business hours (Australia/Sydney)
TIMEZONE=Australia/Sydney
BUSINESS_HOUR_START=9
BUSINESS_HOUR_END=17
SLOT_DURATION_MINUTES=30
DEFAULT_AVAILABILITY_DAYS=5
AVAILABILITY_HORIZON_DAYS=14

# Google Calendar (service account)
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
# Set true for local dev without Google credentials
GOOGLE_CALENDAR_DISABLED=true

# SMTP
NOTIFY_EMAIL=contact@tuvisolutions.com
EMAIL_FROM_ADDRESS=noreply@tuvisolutions.com
EMAIL_FROM_NAME=Tuvi Solutions
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_DISABLED=true
