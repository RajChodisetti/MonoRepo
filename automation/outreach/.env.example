# ============================================================
# TUVI SOLUTIONS — Outreach Agent  ·  Environment Variables
# Copy to .env and fill in your real values
# ============================================================

# ── Hugging Face (scraping + menu OCR — preferred) ───────────
# Set in backend/.env — scripts auto-load MonoRepo/backend/.env
HUGGING_FACE_API_KEY=your_huggingface_token_here
HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct

# ── OpenAI (fallback if HF key unset) ───────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Zoho Mail ───────────────────────────────────────────────
# Find your Account ID at: https://mail.zoho.com/zm/#mail
ZOHO_ACCOUNT_ID=
ZOHO_FROM_EMAIL=outreach@tuvisolutions.com
ZOHO_REGION=com          # com | com.au | eu | in

# Option A — Long-lived access token (simpler, but expires)
ZOHO_ACCESS_TOKEN=

# Option B — OAuth refresh flow (recommended for production)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ── Slack (optional) ────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_REVIEW_CHANNEL=#outreach-review

# ── Google Sheets (optional) ────────────────────────────────
GSHEET_CREDENTIALS_FILE=gsheet_service_account.json
GSHEET_SPREADSHEET_ID=
GSHEET_WORKSHEET_NAME=Leads

# ── Apollo.io (restaurant lead fetch) ─────────────────────────
APOLLO_API_KEY=your_apollo_api_key_here

# ── SerpAPI (legacy restaurant scraper) ───────────────────────
SERPAPI_KEY=your_serpapi_key_here

# ── Google Places API (restaurant scrape from Google Maps) ──
# Enable "Places API" in Google Cloud Console → Credentials → API key
PLACES_API=your_google_places_api_key_here

# ── Menu image OCR (Hugging Face vision — primary) ───────────
MENU_OCR_ENABLED=true
MENU_OCR_MODEL=Qwen/Qwen2-VL-7B-Instruct
MENU_OCR_MAX_IMAGES=15

# ── Gemini (optional fallback if HF + OpenAI unset) ─────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── PostgreSQL (local Docker — same as backend/.env) ───────
# Start: cd MonoRepo && make db-up && make migrate-up
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restaurant_platform?sslmode=disable

# Production (DigitalOcean) — uncomment when deploying to cloud:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:25060/DATABASE?sslmode=require
