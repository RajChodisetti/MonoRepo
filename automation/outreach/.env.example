# ============================================================
# TUVI SOLUTIONS — Outreach Agent  ·  Environment Variables
# Copy to .env and fill in your real values
# ============================================================

# ── Hugging Face (scraping + menu OCR — preferred) ───────────
# Set in backend/.env — scripts auto-load MonoRepo/backend/.env
HUGGING_FACE_API_KEY=
HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct

# ── OpenAI (fallback if HF key unset) ───────────────────────
OPENAI_API_KEY=

# ── Zoho Mail ───────────────────────────────────────────────
# Find your Account ID at: https://mail.zoho.com/zm/#mail
ZOHO_ACCOUNT_ID=
ZOHO_FROM_EMAIL=outreach@tuvisolutions.com
ZOHO_REGION=com          # com | com.au | eu | in

# Option A — Long-lived access token (simpler, but expires)
ZOHO_ACCESS_TOKEN=

# Option B — OAuth refresh flow (recommended for production)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ── Slack (optional) ────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_REVIEW_CHANNEL=#outreach-review

# ── Google Sheets (optional) ────────────────────────────────
GSHEET_CREDENTIALS_FILE=gsheet_service_account.json
GSHEET_SPREADSHEET_ID=
GSHEET_WORKSHEET_NAME=Leads

# ── Apollo.io (targeted contact enrichment after Google Places) ──
# People Search finds decision-makers; People Match fills missing work email.
# Personal email and phone reveal remain disabled.
APOLLO_API_KEY=
APOLLO_API_BASE_URL=https://api.apollo.io/api/v1
APOLLO_ENRICHMENT_ENABLED=true

# ── SerpAPI (legacy restaurant scraper) ───────────────────────
SERPAPI_KEY=

# ── Google Places API (New) — daily discovery + enrichment ───
# Restrict this key to Places API (New) and to the ingestion VM/workload.
GOOGLE_PLACES_API_KEY=
# Legacy alias accepted by older scripts; leave blank when using the canonical key.
PLACES_API=
PLACES_API_BASE_URL=https://places.googleapis.com/v1

# ── Menu image OCR (Hugging Face vision — primary) ───────────
MENU_OCR_ENABLED=true
MENU_OCR_MODEL=Qwen/Qwen2-VL-7B-Instruct
MENU_OCR_MAX_IMAGES=15
LEAD_OCR_VERIFICATION_ENABLED=false
LEAD_OCR_BATCH_SIZE=50
LEAD_OCR_MAX_ATTEMPTS=3
LEAD_OCR_RETRY_AFTER_HOURS=24

# ── Gemini (optional fallback if HF + OpenAI unset) ─────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── PostgreSQL (local Docker — same as backend/.env) ───────
# Start: cd MonoRepo && make db-up && make migrate-up
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restaurant_platform?sslmode=disable

# Production (DigitalOcean) — uncomment when deploying to cloud:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:25060/DATABASE?sslmode=require

# ── Daily lead ingestion (daily_ingestion.py / cron_lead_ingestion.sh) ──
LEAD_INGESTION_ENABLED=false
LEAD_INGESTION_MAX_REQUESTS=500
INGESTION_TYPE=restaurant
INGESTION_CITIES=Sydney,Melbourne,Perth,Adelaide,Brisbane
# Durable city scrape worker. The database enforces a maximum of 500 provider
# calls per 24-hour window regardless of these grid tuning values.
SCRAPE_WORKER_POLL_SECONDS=15
SCRAPE_JOB_LEASE_SECONDS=900
SCRAPE_INITIAL_GRID_ROWS=4
SCRAPE_INITIAL_GRID_COLUMNS=4
SCRAPE_CELL_PAGE_LIMIT=3
SCRAPE_GRID_MAX_DEPTH=12
# Set this in the cron/service environment to load a protected host-side file.
# INGESTION_ENV_FILE=/opt/tuvi/env/ingestion.env
