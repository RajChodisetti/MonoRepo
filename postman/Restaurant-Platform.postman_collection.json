          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/api/v1/admin/me"
          }
        }
      ]
    },
    {
      "name": "05 — Restaurants",
      "description": "Requires `internal_admin` for create/update/archive/members. Owners can list/get assigned restaurants only.",
      "item": [
        {
          "name": "List All",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/restaurants" }
        },
        {
          "name": "List — filter by name",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/restaurants?restaurant=thai",
              "query": [{ "key": "restaurant", "value": "thai", "description": "Name substring search" }]
            }
          }
        },
        {
          "name": "List — filter by status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/restaurants?status=lead",
              "query": [{ "key": "status", "value": "lead" }]
            }
          }
        },
        {
          "name": "List — is_contacted + shown_interest",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/restaurants?is_contacted=true&shown_interest=false",
              "query": [
                { "key": "is_contacted", "value": "true" },
                { "key": "shown_interest", "value": "false" }
              ]
            }
          }
        },
        {
          "name": "List — include archived",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/restaurants?include_archived=true",
              "query": [{ "key": "include_archived", "value": "true" }]
            }
          }
        },
        {
          "name": "Create Restaurant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.environment.set('restaurant_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{restaurant_name}}\",\n  \"email\": \"{{restaurant_email}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/restaurants"
          }
        },
        {
          "name": "Get Restaurant",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}" }
        },
        {
          "name": "Update Restaurant",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Cafe Name\",\n  \"email\": \"updated@example.com\",\n  \"is_contacted\": true,\n  \"shown_interest\": false\n}"
            },
            "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}"
          }
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"demo_ready\"\n}"
            },
            "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}/status"
          }
        },
        {
          "name": "Archive Restaurant",
          "request": { "method": "DELETE", "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}" }
        },
        {
          "name": "List Members",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}/members" }
        },
        {
          "name": "Add Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{owner_user_id}}\",\n  \"member_role\": \"owner\"\n}"
            },
            "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}/members"
          }
        }
      ]
    },
    {
      "name": "06 — Demo Sites",
      "item": [
        {
          "name": "Create Demo Site",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const b = pm.response.json();",
                  "  pm.environment.set('demo_slug', b.slug);",
                  "  pm.environment.set('demo_token', b.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"{{demo_slug}}\",\n  \"status\": \"published\",\n  \"public_payload\": {\n    \"restaurant_name\": \"Demo Thai Kitchen\",\n    \"cuisine\": \"Thai\",\n    \"hero\": \"Welcome to our demo restaurant\",\n    \"reservation_cta\": \"Book a table\"\n  }\n}"
            },
            "url": "{{base_url}}/api/v1/restaurants/{{restaurant_id}}/demo-sites"
          }
        }
      ]
