ENVIRONMENT=development
PORT=8001
# Public HTTPS URL for Twilio (ngrok in local dev). See CALLING.md.
PUBLIC_BASE_URL=http://localhost:8001

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX
TWILIO_VERIFIED_CALLER_IDS=
HUMAN_AGENT_NUMBER=

CALL_API_SECRET=change-me-call-api-secret
PHONE_CALL_MAX_MINUTES=3

# Sarvam (STT + TTS) — required for Andre
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# Girl voices per language (bulbul:v3). Overrides optional; defaults: en=simran, hi=priya, te=kavitha.
SARVAM_TTS_VOICE=priya
SARVAM_TTS_VOICE_EN=simran
SARVAM_TTS_VOICE_HI=priya
SARVAM_TTS_VOICE_TE=kavitha
# Conversational pace (1.0 = normal; >1 = faster). Temp ~0.6 keeps speech clear.
SARVAM_TTS_PACE=1.15
SARVAM_TTS_TEMPERATURE=0.6
DEFAULT_LANGUAGE=en

# OpenAI LLM
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-5.5
LLM_CONTEXT_PAIRS=5

# Kept for parity with voice-sales-agent (unused by Andre hot path)
DEEPGRAM_API_KEY=your_deepgram_key
CARTESIA_API_KEY=your_cartesia_key
CARTESIA_VOICE_ID=
CARTESIA_LANGUAGE=en_in
MONOREPO_API_URL=http://localhost:8080
API_TIMEOUT_MS=2000
TUVI_WEBSITE_API_URL=http://localhost:8080
TUVI_API_TOKEN=
TUVI_API_TIMEOUT_MS=20000

# Gradio test UI
ANDRE_AGENT_URL=http://127.0.0.1:8001
GRADIO_PORT=7860
