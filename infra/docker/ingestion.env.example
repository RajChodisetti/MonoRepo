# Copy to /opt/tuvi/env/ingestion.env on the VM and keep mode 0600.
# Provider secrets must remain outside source control.

# Places API (New) discovers restaurants; Apollo only fills missing owner/email data.
GOOGLE_PLACES_API_KEY=
PLACES_API_BASE_URL=https://places.googleapis.com/v1
# The Go API uses a separate places-api.env containing only the Places key and
# photo-resolution settings; do not mount this entire ingestion file into it.
APOLLO_API_KEY=
APOLLO_API_BASE_URL=https://api.apollo.io/api/v1
APOLLO_ENRICHMENT_ENABLED=true

# Optional legacy SerpAPI workflows; not used by the durable Places-first worker.
SERPAPI_KEY=

# Durable city worker controls. The database enforces the 500-call/24-hour window.
SCRAPE_WORKER_POLL_SECONDS=15
SCRAPE_JOB_LEASE_SECONDS=900
SCRAPE_INITIAL_GRID_ROWS=4
SCRAPE_INITIAL_GRID_COLUMNS=4
SCRAPE_CELL_PAGE_LIMIT=3
SCRAPE_GRID_MAX_DEPTH=12

# OCR remains disabled until a controlled batch is approved.
HUGGING_FACE_API_KEY=
HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_VISION_MODEL=google/gemma-3-4b-it:deepinfra
MENU_OCR_MODEL=google/gemma-3-4b-it:deepinfra
LEAD_OCR_VERIFICATION_ENABLED=false
LEAD_OCR_BATCH_SIZE=50
LEAD_OCR_MAX_ATTEMPTS=3
LEAD_OCR_RETRY_AFTER_HOURS=24
LEAD_OCR_DAILY_REQUEST_LIMIT=200
OCR_WORKER_POLL_SECONDS=900
MENU_OCR_TIMEOUT=45
