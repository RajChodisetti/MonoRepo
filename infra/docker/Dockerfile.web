FROM node:22-alpine AS builder
WORKDIR /src/apps/web
COPY apps/web/package*.json ./
RUN npm ci
COPY apps/web ./

ARG NEXT_PUBLIC_BASE_PATH=/admin

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}

RUN npm run build \
    && npm prune --omit=dev \
    && rm -rf .next/cache

FROM node:22-alpine
WORKDIR /src/apps/web
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3002
ENV HOSTNAME=0.0.0.0

# next start re-evaluates next.config.ts (and therefore its basePath) at
# server boot, not just at build time — this must be set here too, not only
# in the builder stage above, or the running server silently serves with no
# basePath even though the prebuilt static assets/manifest were generated
# with one.
ARG NEXT_PUBLIC_BASE_PATH=/admin
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}

COPY --from=builder /src/apps/web/package*.json ./
COPY --from=builder /src/apps/web/node_modules ./node_modules
COPY --from=builder /src/apps/web/.next ./.next
COPY --from=builder /src/apps/web/public ./public
COPY --from=builder /src/apps/web/next.config.ts ./next.config.ts

EXPOSE 3002
CMD ["./node_modules/.bin/next", "start", "-p", "3002", "-H", "0.0.0.0"]
