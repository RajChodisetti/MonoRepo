# Build from repo root: docker build -f infra/docker/Dockerfile.backend .
FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY backend ./backend

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/api ./backend/cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/worker ./backend/cmd/worker
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/migrate ./backend/cmd/migrate

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata chromium ttf-freefont \
    && addgroup -S -g 10001 tuvi \
    && adduser -S -D -H -u 10001 -G tuvi tuvi \
    && mkdir -p /tmp/tuvi/.cache \
    && chown -R 10001:10001 /tmp/tuvi

WORKDIR /app
COPY --from=builder /out/api /out/worker /out/migrate /app/
COPY backend/migrations /app/backend/migrations

ENV APP_ENV=production
ENV HTTP_ADDR=:8080
ENV HOME=/tmp/tuvi
ENV TMPDIR=/tmp/tuvi
ENV XDG_CACHE_HOME=/tmp/tuvi/.cache

EXPOSE 8080

USER 10001:10001

CMD ["/app/api"]
