# Build from repo root: docker build -f infra/docker/Dockerfile.backend .
FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY backend ./backend

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/api ./backend/cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/worker ./backend/cmd/worker
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/migrate ./backend/cmd/migrate

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /out/api /out/worker /out/migrate /app/
COPY backend/migrations /app/backend/migrations

ENV APP_ENV=production
ENV HTTP_ADDR=:8080

EXPOSE 8080

CMD ["/app/api"]
