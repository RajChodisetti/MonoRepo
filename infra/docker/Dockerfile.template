FROM node:22-alpine AS builder

WORKDIR /src/template

COPY template/package*.json ./
RUN npm ci

COPY template ./
COPY data ../data

ARG TEMPLATE=2
ARG NEXT_PUBLIC_API_URL=https://api.tuvisolutions.com
ARG NEXT_PUBLIC_VOICE_AGENT_URL=https://voice.tuvisolutions.com

ENV NEXT_TELEMETRY_DISABLED=1
ENV TEMPLATE=${TEMPLATE}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_VOICE_AGENT_URL=${NEXT_PUBLIC_VOICE_AGENT_URL}

RUN npm run build

FROM node:22-alpine

WORKDIR /src/template

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

COPY --from=builder /src/template/package*.json ./
COPY --from=builder /src/template/node_modules ./node_modules
COPY --from=builder /src/template/.next ./.next
COPY --from=builder /src/template/public ./public
COPY --from=builder /src/template/next.config.ts ./next.config.ts
COPY --from=builder /src/data ../data

EXPOSE 3000

CMD ["npm", "run", "start", "--", "-p", "3000", "-H", "0.0.0.0"]
