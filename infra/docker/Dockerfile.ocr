# Build from the repository root:
# docker build -f infra/docker/Dockerfile.ocr .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 10001 outreach

WORKDIR /app/outreach

COPY automation/outreach/requirements.ocr.txt /tmp/requirements.ocr.txt
RUN pip install --no-cache-dir -r /tmp/requirements.ocr.txt

COPY automation/outreach/verify_leads_from_db.py ./
COPY automation/outreach/import_to_db.py ./
COPY automation/outreach/menu_image_ocr.py ./
COPY automation/outreach/google_places_photo.py ./
COPY automation/outreach/hf_llm.py ./
COPY automation/outreach/env_loader.py ./
COPY automation/outreach/scrape_safety.py ./
COPY automation/outreach/tuvi_outreach_agent.py ./

USER outreach

CMD ["python", "verify_leads_from_db.py"]
