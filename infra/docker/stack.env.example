# Copy to stack.env before starting the VM Compose stack.
# VM services use DATABASE_URL exactly as provided. Keep the local postgres URL
# for a self-contained stack, or use a dedicated external database and role.

APP_NAME=restaurant-platform
APP_ENV=production
APP_VERSION=dev

HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=https://tuvisolutions.com,https://www.tuvisolutions.com,https://demo.tuvisolutions.com

LOG_LEVEL=info
LOG_FORMAT=text

# Keep these four values aligned. URL-encode POSTGRES_PASSWORD when placing it
# in DATABASE_URL if the production password contains reserved URL characters.
POSTGRES_USER=tuvi
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=restaurant_platform
TUVI_POSTGRES_PORT=15432
DATABASE_URL=postgres://tuvi:replace-with-a-strong-password@postgres:5432/restaurant_platform?sslmode=disable
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_CONNECT_TIMEOUT=5s

EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_API_BASE_URL=https://api.resend.com
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tuvi Solutions
EMAIL_DISABLE_SENDING=true
# Legacy/generic adapter switch. Gmail outreach execution is controlled by the
# persisted admin UI toggle; OAuth credentials remain in secret configuration.
# Must remain empty in production; startup validation rejects a redirect target.
EMAIL_REDIRECT_TO=
EMAIL_OPEN_TRACKING_ENABLED=true

# Required only when EMAIL_PROVIDER=zoho for the generic/non-bulk adapter.
# The independently rotated outreach accounts are configured below.
ZOHO_ACCOUNT_ID=
ZOHO_FROM_EMAIL=
ZOHO_REGION=com
ZOHO_API_BASE_URL=https://mail.zoho.com/api/accounts
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Outreach stays disabled in PostgreSQL until an admin enables the job in the UI.
OUTREACH_BULK_MAX=150
OUTREACH_EMAILS_PER_ACCOUNT=40
# Forty durable slots over eight hours (~12 minutes per slot), with a persisted
# random 2-5 minute offset and a cross-account minimum-delay guard.
OUTREACH_SEND_WINDOW=8h
OUTREACH_SEND_JITTER_MIN=2m
OUTREACH_SEND_JITTER_MAX=5m
OUTREACH_EMAIL_COOLDOWN=24h
OUTREACH_EMAIL_HEALTH_ENABLED=true
OUTREACH_EMAIL_HEALTH_RECIPIENT=rajchodisetti@gmail.com
OUTREACH_EMAIL_HEALTH_INTERVAL=24h
# Restaurant outreach uses Gmail only. Add another JSON object for another
# mailbox; no application code change is required. Each entry needs an OAuth
# client and per-mailbox refresh token with gmail.send permission, not an API key.
OUTREACH_ZOHO_ACCOUNTS_JSON=[]
OUTREACH_GOOGLE_WORKSPACE_ACCOUNTS_JSON=[]

PUBLIC_BASE_URL=https://api.tuvisolutions.com
PUBLIC_WEB_URL=https://demo.tuvisolutions.com
PUBLIC_MARKETING_URL=https://tuvisolutions.com
PRESENTATION_SITE_URL=https://tuvisolutions.com/services/restaurants

# Durable restaurant-owned/licensed media. For DigitalOcean Spaces, endpoint
# is typically https://<region>.digitaloceanspaces.com and the public base can
# be the bucket CDN hostname. Google Places photos are never copied here.
STORAGE_PROVIDER=disabled
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=
STORAGE_USE_PATH_STYLE=false
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# This public-only value is also supplied as a template image allowlist at build time.
TEMPLATE_MEDIA_PUBLIC_BASE_URL=

# Tuvi company consultation scheduler (served by the main API)
TUVI_API_TOKEN=change-me-tuvi-api-token-min-32-chars
# Compose interpolates this for the website service even when a targeted subset
# is started. Keep the same server-side value in voice/template environments.
CALL_API_SECRET=change-me-call-api-secret-min-32-chars
CONSULTATION_NOTIFY_EMAIL=contact@tuvisolutions.com
CONSULTATION_TIMEZONE=Australia/Sydney
CONSULTATION_BUSINESS_HOUR_START=9
CONSULTATION_BUSINESS_HOUR_END=17
CONSULTATION_SLOT_DURATION_MINUTES=30
CONSULTATION_DEFAULT_AVAILABILITY_DAYS=5
CONSULTATION_AVAILABILITY_HORIZON_DAYS=14
CONSULTATION_GOOGLE_CALENDAR_DISABLED=true
CONSULTATION_GOOGLE_CALENDAR_ID=
CONSULTATION_GOOGLE_SERVICE_ACCOUNT_JSON=

TOKEN_SECRET=change-me-in-production-min-32-chars!!
JWT_ACCESS_TOKEN_TTL=24h

DEMO_TOKEN_TTL=720h

JOB_BUFFER_SIZE=32
JOB_RETRY_DELAY=2s
