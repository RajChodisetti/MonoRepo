# Copy to stack.env before starting the VM Compose stack.
# VM services use DATABASE_URL exactly as provided. Keep the local postgres URL
# for a self-contained stack, or use a dedicated external database and role.

APP_NAME=restaurant-platform
APP_ENV=production
APP_VERSION=dev

HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

LOG_LEVEL=info
LOG_FORMAT=text

DATABASE_URL=postgres://postgres:postgres@postgres:5432/restaurant_platform?sslmode=disable
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_CONNECT_TIMEOUT=5s

EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_API_BASE_URL=https://api.resend.com
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tuvi Solutions
EMAIL_DISABLE_SENDING=true
EMAIL_REDIRECT_TO=
EMAIL_OPEN_TRACKING_ENABLED=true

PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000

# Tuvi company consultation scheduler (served by the main API)
TUVI_API_TOKEN=change-me-tuvi-api-token-min-32-chars
CONSULTATION_NOTIFY_EMAIL=contact@tuvisolutions.com
CONSULTATION_TIMEZONE=Australia/Sydney
CONSULTATION_BUSINESS_HOUR_START=9
CONSULTATION_BUSINESS_HOUR_END=17
CONSULTATION_SLOT_DURATION_MINUTES=30
CONSULTATION_DEFAULT_AVAILABILITY_DAYS=5
CONSULTATION_AVAILABILITY_HORIZON_DAYS=14
CONSULTATION_GOOGLE_CALENDAR_DISABLED=true
CONSULTATION_GOOGLE_CALENDAR_ID=
CONSULTATION_GOOGLE_SERVICE_ACCOUNT_JSON=

TOKEN_SECRET=change-me-in-production-min-32-chars!!
JWT_ACCESS_TOKEN_TTL=24h

DEMO_TOKEN_SECRET=change-me-demo-token-secret-32chars!!
DEMO_TOKEN_TTL=720h

JOB_BUFFER_SIZE=32
JOB_RETRY_DELAY=2s
