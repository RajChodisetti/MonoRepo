# Copy to stack.env (or use backend/.env) before: make up
# Docker stack overrides DATABASE_URL to use the postgres service hostname.

APP_NAME=restaurant-platform
APP_ENV=production
APP_VERSION=dev

HTTP_ADDR=:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_LEVEL=info
LOG_FORMAT=text

DATABASE_URL=postgres://postgres:postgres@postgres:5432/restaurant_platform?sslmode=disable
DATABASE_MAX_CONNS=5
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_CONNECT_TIMEOUT=5s

EMAIL_PROVIDER=disabled
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Tuvi Solutions
EMAIL_DISABLE_SENDING=true
EMAIL_REDIRECT_TO=
EMAIL_OPEN_TRACKING_ENABLED=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000

TOKEN_SECRET=change-me-in-production-min-32-chars!!
JWT_ACCESS_TOKEN_TTL=24h

DEMO_TOKEN_SECRET=change-me-demo-token-secret-32chars!!
DEMO_TOKEN_TTL=720h

JOB_BUFFER_SIZE=32
JOB_RETRY_DELAY=2s
