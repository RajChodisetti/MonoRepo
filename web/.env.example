# Server-only — never prefix with NEXT_PUBLIC_ unless noted.
# SEO search/report is served by MonoRepo Go API (Places key lives there).

MONOREPO_API_URL=http://localhost:8080

# Consultation booking uses the main Go API and PostgreSQL slot ledger.
# CONSULTATION_API_URL defaults to MONOREPO_API_URL when omitted.
CONSULTATION_API_URL=http://localhost:8080
TUVI_API_TOKEN=local-dev-tuvi-api-token-change-me

# Public company details used in rendered links and support copy.
NEXT_PUBLIC_CONTACT_EMAIL=contact@tuvisolutions.com
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/tuvi-solutions

# Voice agent (inbound browser conversation only; outbound callbacks are disabled)
# Public URL used by the browser WebSocket client
NEXT_PUBLIC_VOICE_AGENT_URL=http://localhost:8000
# Optional server-only override for Next API proxies
# VOICE_AGENT_URL=http://localhost:8000
# Optional displayed call-in number (E.164)
NEXT_PUBLIC_CALL_IN_NUMBER=
