# Server-only — never prefix with NEXT_PUBLIC_ unless noted.
# SEO search/report is served by MonoRepo Go API (Places key lives there).

MONOREPO_API_URL=http://localhost:8080

# Voice agent (browser talk + callback dial)
# Public URL used by the browser WebSocket client
NEXT_PUBLIC_VOICE_AGENT_URL=http://localhost:8000
# Optional server-only override for Next API proxies
# VOICE_AGENT_URL=http://localhost:8000
# Same secret as MonoRepo/voice-sales-agent CALL_API_SECRET
CALL_API_SECRET=
# Optional displayed call-in number (E.164)
NEXT_PUBLIC_CALL_IN_NUMBER=
